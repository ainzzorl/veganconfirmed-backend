# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=development
PORT=5555

# Logging Configuration
LOG_LEVEL=INFO

# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Cloud Configuration (used for Cloud Logging page visit stats and for
# the desktop-server Firestore job queue). This can be the same as
# FIREBASE_PROJECT_ID.
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# Project the cloud functions are deployed into (`make deploy-service`,
# `make deploy-weekly-report`). Unused by the running service.
PROJECT_ID=your-gcp-project

# Desktop-server (local LLM) Configuration
# Whether the local desktop-server is available at all; PROVIDER_BY_TRIGGER
# (analysis_core.py) decides which requests it gets.
USE_DESKTOP_SERVER=true
# Disable the Gemini fallback (used by integration tests). When true, GEMINI_API_KEY
# is not required and desktop-server failures propagate instead of falling back.
DISABLE_GEMINI_FALLBACK=false
# Model the desktop-server should run (LM Studio model id).
LMS_MODEL=openai/gpt-oss-120b
LMS_MAX_TOKENS=2048
# Firestore collections shared with desktop-server.
LMS_JOBS_COLLECTION=lms_jobs
DESKTOP_STATUS_COLLECTION=desktop_server_status
DESKTOP_STATUS_DOC=worker
# Timeouts / liveness (seconds).
DESKTOP_PICKUP_TIMEOUT_SECONDS=10
DESKTOP_COMPLETION_TIMEOUT_SECONDS=180
DESKTOP_HEARTBEAT_MAX_AGE_SECONDS=30
# desktop-server checkout for the local worker (make run-local, tests/*/run.sh).
DESKTOP_SERVER_DIR=/path/to/desktop-server
# Run that worker on this host over SSH instead, from DESKTOP_SERVER_DIR there.
# DESKTOP_SERVER_HOST=gpu-box.local

# Whether a page's own declaration of its kind (og:type, schema.org types the
# extension forwards as page_signals) may narrow what the model is asked. The
# signals are recorded on every request either way; this only decides whether
# they are allowed to prune a branch. See services/page_scope.py.
PAGE_SIGNAL_SCOPE=true

# Key for the IP hash on records (services/privacy.py). Changing it breaks
# continuity with existing hashes. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SECRET=your-random-secret
# GEOIP_DB_PATH=data/dbip-country-lite.mmdb

# Local database viewer (db_viewer.py) at http://localhost:5555/debug/db/.
# Unauthenticated, so it only ever answers requests that came from this machine
# directly; set to false to switch it off entirely.
ENABLE_DB_VIEWER=true

# Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_LOGIN=your-login@gmail.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=recipient@example.com